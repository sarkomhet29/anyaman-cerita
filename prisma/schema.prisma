// Prisma schema — definisi struktur database
// Dokumentasi: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Contoh model dasar — silakan diubah sesuai kebutuhan
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  phone     String?  // nomor WhatsApp klien (opsional) — dipakai notifikasi & detail pesanan
  password  String   // simpan hash-nya saja (bcrypt), jangan plaintext
  role      String   @default("user") // user | admin
  twoFactorSecret   String? // kunci rahasia TOTP (Base32) untuk 2FA admin
  twoFactorEnabled  Boolean @default(false)
  paketId   String?  // ID paket berlangganan
  paket     Paket?   @relation(fields: [paketId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  posts     Post[]
  undangan  Undangan[]
  transactions Transaction[]
  verifiedTransactions Transaction[] @relation("Verifikator")
  loginLogs LoginLog[]
}

// Log login admin (waktu, IP, user-agent, sukses/gagal) untuk monitoring.
model LoginLog {
  id        String   @id @default(cuid())
  email     String
  userId    String?  // diisi jika user ditemukan
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  ip        String?  // alamat IP pemohon
  userAgent String?  // user-agent browser
  status    String   @default("success") // success | failed
  reason    String?  // misal "password salah", "kode 2FA salah", "terkunci"
  createdAt DateTime @default(now())

  @@index([email])
  @@index([userId])
  @@index([createdAt])
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  author    User     @relation(fields: [authorId], references: [id])
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Paket Berlangganan (Uji Coba, Dasar, Lengkap, Premium)
model Paket {
  id          String   @id @default(cuid())
  nama        String   @unique // "Uji Coba", "Dasar", "Lengkap", "Premium"
  harga       Int      // dalam rupiah, 0 untuk uji coba
  deskripsi   String?
  urutan      Int      @default(0) // untuk sorting
  highlight   Boolean  @default(false) // tandai paket favorit
  users       User[]
  fitur       PaketFitur[]
  transactions Transaction[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([urutan])
}

// Relasi antara Paket dan Fitur (Many-to-Many)
model PaketFitur {
  id       String @id @default(cuid())
  paketId  String
  paket    Paket  @relation(fields: [paketId], references: [id], onDelete: Cascade)
  fiturKey String // key dari FEATURES di src/lib/features.ts
  
  @@unique([paketId, fiturKey])
  @@index([paketId])
}

// Satu baris = satu undangan yang dibuat pengguna
model Undangan {
  id             String   @id @default(cuid())
  slug           String   @unique // dipakai di URL publik: /u/{slug}
  userId         String   // siapa yang membuat undangan
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jenisAcara     String // Pernikahan, Khitanan, Aqiqah, dst
  namaUtama      String // "Ayu & Bagas" atau "Aqiqah Baby Alma"
  tanggalAcara   DateTime
  waktuAcara     String? // teks bebas, misal "09.00 - selesai"
  lokasi         String // nama tempat/venue
  alamatLengkap  String?
  mapsUrl        String?
  tema           String   @default("songket-senja")
  pesanUndangan  String? // kalimat pembuka/doa, opsional
  status         String   @default("draft") // draft | aktif
  aktifSampai    DateTime? // batas aktif undangan (masa berlangganan), diisi saat pembayaran disetujui
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  tamu           Tamu[]
  transactions   Transaction[]

  @@index([status])
  @@index([userId])
}

// Daftar tamu per undangan — dipakai untuk RSVP & buku ucapan
model Tamu {
  id         String   @id @default(cuid())
  undangan   Undangan @relation(fields: [undanganId], references: [id], onDelete: Cascade)
  undanganId String
  nama       String
  kehadiran  String? // "hadir" | "tidak_hadir" | null (belum merespons)
  ucapan     String?
  createdAt  DateTime @default(now())

  @@index([undanganId])
}

// Pesan support yang dikirim lewat form Contact
model ContactMessage {
  id        String   @id @default(cuid())
  nama      String
  email     String
  subjek    String
  pesan     String
  status    String   @default("baru") // baru | dibaca | selesai
  createdAt DateTime @default(now())

  @@index([status])
  @@index([createdAt])
}

// Transaksi pembayaran upgrade paket
// Alur manual: pending -> menunggu_verifikasi (bukti diunggah) -> aktif | ditolak
// Alur Midtrans: pending -> success | failed | expired
enum StatusPembayaran {
  pending
  menunggu_verifikasi
  aktif
  ditolak
  success
  failed
  expired
}

model Transaction {
  id              String          @id @default(cuid())
  userId          String
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  paketId         String
  paket           Paket           @relation(fields: [paketId], references: [id], onDelete: Cascade)
  amount          Int
  status          StatusPembayaran @default(pending)
  paymentMethod   String   @default("manual") // manual (transfer) | midtrans
  buktiUrl        String?  // path file bukti transfer (diunggah klien)
  nominalBukti    Int?     // nominal tertera di bukti transfer — isian admin saat verifikasi manual
  catatanAdmin    String?  // catatan/alasan admin (misal alasan penolakan)
  undanganId      String?  // undangan yang akan diaktifkan setelah pembayaran disetujui
  undangan        Undangan? @relation(fields: [undanganId], references: [id], onDelete: SetNull)
  verifiedById    String?  // admin yang memverifikasi pembayaran manual
  verifiedBy      User?    @relation("Verifikator", fields: [verifiedById], references: [id], onDelete: SetNull)
  verifiedAt      DateTime? // waktu pembayaran disetujui/ditolak
  midtransId      String?  // transaction ID dari Midtrans
  orderId         String   @unique // order ID unik untuk Midtrans
  paymentUrl      String?  // URL untuk redirect ke Midtrans
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  paidAt          DateTime? // waktu pembayaran berhasil

  @@index([userId])
  @@index([status])
  @@index([midtransId])
}
