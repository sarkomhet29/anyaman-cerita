# Salin file ini menjadi .env dan isi nilai sebenarnya.
# JANGAN PERNAH commit file .env ke Git!

DATABASE_URL="postgresql://myapp:gantidenganpasswordkuat@localhost:5432/myapp"
NODE_ENV="development"

# Kunci untuk menandatangani cookie sesi login (/dashboard).
# Buat nilai acak minimal 32 karakter, misal lewat: openssl rand -base64 32
SESSION_SECRET="gantidengan-string-acak-minimal-32-karakter"

# Midtrans (pembayaran). Ambil dari dashboard https://dashboard.sandbox.midtrans.com
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""

# Seed admin (opsional) — dipakai prisma/seed-admin.js jika diisi
ADMIN_EMAIL="admin@anyamancerita.com"
ADMIN_PASSWORD="gantidengan-password-admin-kuat"

# Seed user uji coba (opsional) — dipakai prisma/seed-user.js jika diisi
SEED_USER_EMAIL="test@example.com"
SEED_USER_PASSWORD="Password123"

# URL publik aplikasi (dipakai notifikasi, link undangan, dsb)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Nomor WhatsApp admin (format internasional tanpa tanda +) — dipakai notifikasi
WA_ADMIN="6281211073408"

# Token Fonnte (https://fonnte.com) — push WhatsApp otomatis ke admin saat
# klien mengunggah bukti transfer. Kosongkan untuk memakai fallback link wa.me + email.
FONNTE_TOKEN=""

# Whitelist IP admin (opsional) — pisahkan dengan koma. Support IP persis "203.0.113.5"
# atau CIDR "203.0.113.0/24". Kosongkan untuk mengizinkan semua IP.
ADMIN_IP_WHITELIST=""

# Sesi admin: masa aktif 60 menit, di-refresh otomatis saat ada aktivitas
# (sliding window) — dikelola di src/middleware.ts, tak perlu diisi manual.

# Rekening tujuan transfer manual (ditampilkan ke klien saat checkout)
REKENING_BANK="BCA"
REKENING_NOMOR="1234567890"
REKENING_ATAS_NAMA="Anyaman Cerita"

# SMTP — dipakai email notifikasi (bukti transfer, verifikasi pembayaran, kontak)
# Bisa pakai Gmail/mail provider lain. Kosongkan untuk menonaktifkan email.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="noreply@anyamancerita.com"
